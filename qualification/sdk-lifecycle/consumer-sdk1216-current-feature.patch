new file mode 100644
index 0000000000000000000000000000000000000000..7791e5d2e2403cb2adbc44d6023995c9a9d220e6
--- /dev/null
+++ b/crates/mcp/tests/sdk1216_order.rs
@@ -0,0 +1,50 @@
+//! Published SDK fake ordering discriminator, not a product lifecycle fix.
+use enshwick::{Load, Mod, Off, abi::Status, schedule::Scheduler};
+use std::sync::Mutex;
+
+static SCHEDULER: Mutex<Option<Scheduler>> = Mutex::new(None);
+static EVENTS: Mutex<Vec<&'static str>> = Mutex::new(Vec::new());
+struct Driver;
+impl Mod for Driver {
+    fn init(load: &mut Load<'_>) -> Result<Self, Off> {
+        *SCHEDULER.lock().unwrap() = Some(load.scheduler()?);
+        load.on::<enshwick::events::WorldLoaded>(|()| EVENTS.lock().unwrap().push("loaded"))?;
+        Ok(Self)
+    }
+}
+enshwick::test::declare_mod!(Driver, "id = \"test.sdk-order\"\nside = \"server\"");
+
+fn start() -> (enshwick::test::Installed, Scheduler) {
+    EVENTS.lock().unwrap().clear();
+    let loader = enshwick::test::FakeHost::new().world().install();
+    // SAFETY: the exports belong to this isolated fake-only driver.
+    assert_eq!(
+        unsafe { loader.start(enshwick_mod_query, enshwick_mod_init, enshwick_mod_ready) },
+        Status::OK
+    );
+    assert_eq!(loader.raise::<enshwick::events::WorldLoaded>(&()), 1);
+    let _ = loader.tick(enshwick::events::Ticked::DEFAULT_EVERY);
+    EVENTS.lock().unwrap().clear();
+    let scheduler = SCHEDULER.lock().unwrap().unwrap();
+    (loader, scheduler)
+}
+
+#[test]
+fn repeated_loaded_event_runs_queued_task_before_loaded_handler() {
+    let (loader, scheduler) = start();
+    scheduler.next_tick(|| EVENTS.lock().unwrap().push("old-task"));
+    assert_eq!(loader.raise::<enshwick::events::WorldLoaded>(&()), 1);
+    assert_eq!(*EVENTS.lock().unwrap(), ["old-task", "loaded"]);
+}
+
+#[test]
+fn real_fake_game_boundary_discards_old_task_and_runs_new_game_task() {
+    let (loader, scheduler) = start();
+    scheduler.next_tick(|| EVENTS.lock().unwrap().push("old-task"));
+    loader.end_game();
+    assert_eq!(loader.raise::<enshwick::events::WorldLoaded>(&()), 1);
+    assert_eq!(*EVENTS.lock().unwrap(), ["loaded"]);
+    scheduler.next_tick(|| EVENTS.lock().unwrap().push("new-task"));
+    let _ = loader.tick(enshwick::events::Ticked::DEFAULT_EVERY);
+    assert_eq!(*EVENTS.lock().unwrap(), ["loaded", "new-task"]);
+}
