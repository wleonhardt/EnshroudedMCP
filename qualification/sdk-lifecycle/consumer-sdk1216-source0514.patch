new file mode 100644
index 0000000000000000000000000000000000000000..41826ae8bee362c642e661bf15ffe8383f14a454
--- /dev/null
+++ b/crates/mcp/src/sdk1216_lifecycle.rs
@@ -0,0 +1,38 @@
+//! Test-only SDK12.16 cross-game queue behavior, separate from epoch guards.
+use enshwick::test::Installed;
+use serde_json::Value;
+use std::{
+    thread,
+    time::{Duration, Instant},
+};
+
+pub(crate) fn refuse_old_game_read(
+    loader: &Installed,
+    worker: thread::JoinHandle<Result<Value, String>>,
+) {
+    // A repeated WorldLoaded runs queued tasks before its handlers. End the
+    // actual fake game instead: SDK tasks belong to their originating game.
+    loader.end_game();
+    assert!(loader.raise::<enshwick::events::WorldLoaded>(&()) > 0);
+    let until = Instant::now() + Duration::from_secs(2);
+    while !worker.is_finished() && Instant::now() < until {
+        let _ = loader.tick(enshwick::events::Ticked::DEFAULT_EVERY);
+        thread::yield_now();
+    }
+    assert!(
+        worker.is_finished(),
+        "old-game read did not return after SDK discard"
+    );
+    let error = worker
+        .join()
+        .unwrap()
+        .expect_err("old-game read returned data");
+    // The receiver distinguishes disconnection from an elapsed deadline.
+    // This fake boundary proves SDK discard, not native cancellation.
+    assert!(
+        error.starts_with(
+            "the game-thread reply channel disconnected before a reply; execution outcome unknown;"
+        ),
+        "{error}"
+    );
+}
