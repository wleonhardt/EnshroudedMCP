+// Disposable source instrumentation. Never install this consumer.
+mod timing {
+    use std::{
+        cell::RefCell,
+        path::Path,
+        time::{Duration, Instant},
+    };
+    #[derive(Default)]
+    struct Trace {
+        rows: Vec<(&'static str, &'static str, Duration)>,
+        dropped: usize,
+        #[cfg(test)]
+        sequence: usize,
+        #[cfg(test)]
+        operation: String,
+        #[cfg(test)]
+        fixture_tag: Option<String>,
+        #[cfg(test)]
+        thread_name: Option<String>,
+        delay: bool,
+    }
+    thread_local! { static TRACE: RefCell<Trace> = RefCell::new(Trace::default()); }
+    #[cfg(test)]
+    pub(super) fn begin() {
+        TRACE.with(|t| {
+            *t.borrow_mut() = Trace {
+                rows: Vec::with_capacity(128),
+                ..Trace::default()
+            }
+        });
+    }
+    #[cfg(test)]
+    fn begin_request(operation: &str, dir: Option<&Path>) {
+        TRACE.with(|t| {
+            let mut t = t.borrow_mut();
+            t.rows.clear();
+            t.dropped = 0;
+            t.sequence += 1;
+            t.operation = operation.to_owned();
+            t.fixture_tag = dir
+                .and_then(Path::file_name)
+                .and_then(|name| name.to_str())
+                .map(str::to_owned);
+            t.thread_name = std::thread::current().name().map(str::to_owned);
+        });
+    }
+    fn record(kind: &'static str, stage: &'static str, elapsed: Duration) {
+        TRACE.with(|t| {
+            let mut t = t.borrow_mut();
+            if t.rows.len() < 128 {
+                t.rows.push((kind, stage, elapsed));
+            } else {
+                t.dropped += 1;
+            }
+        });
+    }
+    pub(super) fn age(stage: &'static str, elapsed: Duration) {
+        record("queued_age", stage, elapsed);
+    }
+    pub(super) fn timed<T>(stage: &'static str, work: impl FnOnce() -> T) -> T {
+        let start = Instant::now();
+        let result = work();
+        record("duration", stage, start.elapsed());
+        result
+    }
+    pub(super) struct Scope(&'static str, Instant);
+    impl Scope {
+        pub(super) fn new(stage: &'static str) -> Self {
+            Self(stage, Instant::now())
+        }
+        pub(super) fn request(operation: &str, dir: Option<&Path>) -> Self {
+            let start = Instant::now();
+            #[cfg(test)]
+            begin_request(operation, dir);
+            #[cfg(not(test))]
+            let _ = (operation, dir);
+            Self("run_total", start)
+        }
+    }
+    impl Drop for Scope {
+        fn drop(&mut self) {
+            record("duration", self.0, self.1.elapsed());
+            #[cfg(test)]
+            if self.0 == "run_total" {
+                report();
+            }
+        }
+    }
+    #[cfg(test)]
+    pub(super) fn arm_delay() {
+        TRACE.with(|t| t.borrow_mut().delay = true);
+    }
+    pub(super) fn after_marker_sync() {
+        let delay = TRACE.with(|t| std::mem::take(&mut t.borrow_mut().delay));
+        if delay {
+            timed("injected_after_marker_sync_wait", || {
+                std::thread::sleep(policy::client_control::WAIT + Duration::from_millis(50))
+            });
+        }
+    }
+    #[cfg(test)]
+    pub(super) fn count(stage: &str) -> usize {
+        TRACE.with(|t| {
+            t.borrow()
+                .rows
+                .iter()
+                .filter(|(_, name, _)| *name == stage)
+                .count()
+        })
+    }
+    #[cfg(test)]
+    pub(super) fn injected_wait_exceeded_deadline() -> bool {
+        TRACE.with(|t| {
+            t.borrow().rows.iter().any(|(_, name, elapsed)| {
+                *name == "injected_after_marker_sync_wait"
+                    && *elapsed >= policy::client_control::WAIT
+            })
+        })
+    }
+    #[cfg(test)]
+    pub(super) fn report() {
+        TRACE.with(|t| {
+            let t = t.borrow();
+            if t.dropped == 0
+                && !t.rows.iter().any(|(_, _, elapsed)| *elapsed >= policy::client_control::WAIT)
+            {
+                return;
+            }
+            let rows: Vec<_> = t.rows.iter().map(|(kind, stage, elapsed)| serde_json::json!({"kind":kind,"stage":stage,"elapsed_us":elapsed.as_micros()})).collect();
+            eprintln!("CLIENT_TIMING {}", serde_json::json!({"rows":rows,"dropped":t.dropped,"limit":128,"request_sequence":t.sequence,"operation":t.operation,"fixture_tag":t.fixture_tag,"thread_name":t.thread_name,"report_policy":"slow_or_truncated","threshold_us":policy::client_control::WAIT.as_micros(),"scope":"one instrumented command interval","game_executed":false}));
+        });
+    }
+}
