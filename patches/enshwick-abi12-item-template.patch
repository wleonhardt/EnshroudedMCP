@@ -133,12 +135,53 @@ mod tests {
             .component(Entity(900), durability, &worn)
             .component(Entity(901), fuel, &lamp)
             .item(enshwick::ItemId::new(SWORD), 1, ItemTypeInfo::HAS_PIDE)
+            .item_category(enshwick::ItemId::new(SWORD), 2)
+            .item(enshwick::ItemId::new(PROP), 8, 0)
+            .item_category(enshwick::ItemId::new(PROP), 3)
+            .item_places(
+                enshwick::ItemId::new(PROP),
+                enshwick::content::Guid(PLACED_TEMPLATE),
+            )
     }
 
     fn record(outcome: &Outcome) {
         OUTCOMES.lock().unwrap().push(outcome.clone());
     }
 
+    #[test]
+    fn an_item_reports_its_placed_template_independently_of_its_pide() {
+        let loader = world().install();
+        // SAFETY: `enshwick_mod_init` is the export of this file's `declare_mod!(Looter)`.
+        assert_eq!(unsafe { loader.init(enshwick_mod_init) }, Status::OK);
+        let inventories = INVENTORIES.get().unwrap();
+        assert!(inventories.item_info(enshwick::ItemId::new(COIN)).is_none());
+        let sword = inventories.item_info(enshwick::ItemId::new(SWORD)).unwrap();
+        assert_eq!(sword.placed_entity_template, None);
+        assert_eq!(
+            (
+                sword.id.get(),
+                sword.max_stack_size,
+                sword.category,
+                sword.flags
+            ),
+            (SWORD, 1, 2, ItemTypeInfo::HAS_PIDE)
+        );
+        let prop = inventories.item_info(enshwick::ItemId::new(PROP)).unwrap();
+        assert_eq!(prop.placed_entity_template, Some(PLACED_TEMPLATE));
+        assert_eq!(
+            (
+                prop.id.get(),
+                prop.max_stack_size,
+                prop.category,
+                prop.flags
+            ),
+            (PROP, 8, 3, 0)
+        );
+        // An inventory item's PIDE and the entity it places are independent.
+        assert!(sword.has_pide());
+        assert!(!prop.has_pide());
+    }
+
